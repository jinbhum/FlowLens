{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlowLens",
  "version": "0.8.0",
  "identifier": "com.flowlens.desktop",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "FlowLens", "width": 1380, "height": 900, "minWidth": 1100, "minHeight": 700, "resizable": true, "decorations": true }], "security": { "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.local; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' 'unsafe-eval'" } },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.ico"] }
}
